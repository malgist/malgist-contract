# ========================================
# Malgist - Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# Never commit .env to git!

# ========================================
# DEPLOYMENT (Required)
# ========================================

# Your wallet private key (WITHOUT 0x prefix)
# Get this from MetaMask: Settings > Security & Privacy > Show Private Key
# ⚠️ NEVER share this or commit it to git!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Mantle Sepolia Testnet RPC URL
# Default: https://rpc.sepolia.mantle.xyz
# Alternatives:
# - https://mantle-sepolia.public.blastapi.io
# - Your own node/provider
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz

# Chain ID for Mantle Sepolia
MANTLE_TESTNET_CHAIN_ID=5003

# ========================================
# CONTRACT VERIFICATION (Optional)
# ========================================

# Mantle Explorer API Key (if available)
# Get from: https://mantlescan.xyz/myapikey
# Note: May not be required for Mantle Sepolia
ETHERSCAN_API_KEY=your_api_key_here_optional

# Mantle Sepolia Block Explorer
MANTLE_EXPLORER=https://sepolia.mantlescan.xyz

# ========================================
# DEPLOYED CONTRACT ADDRESSES
# ========================================
# Fill these in AFTER deploying to save your addresses

# Core Contracts
USDC_ADDRESS=
WMNT_ADDRESS=
USER_VAULT_ADDRESS=
LENDLE_ADAPTER_ADDRESS=
FUSIONX_ADAPTER_ADDRESS=

# Mock Protocol Contracts
LENDING_POOL_ADDRESS=
DEX_ROUTER_ADDRESS=
LP_TOKEN_ADDRESS=

# ========================================
# OPTIONAL: For Frontend Integration
# ========================================

# Next.js Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wallet Connect Project ID (if using)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ========================================
# DEVELOPMENT (Optional)
# ========================================

# Enable verbose logging
DEBUG=false

# Foundry-specific settings
# Disable nightly build warnings
FOUNDRY_DISABLE_NIGHTLY_WARNING=true

# ========================================
# NOTES
# ========================================
# 
# 1. Get testnet MNT: https://faucet.sepolia.mantle.xyz/
# 2. Deploy contracts: forge script script/DeployUserVault.s.sol --broadcast
# 3. Save all deployed addresses in this file
# 4. Verify contracts using DEPLOY_AND_VERIFY.md guide
#
# Security Reminder:
# - .env is in .gitignore (DO NOT remove it)
# - Never share your PRIVATE_KEY
# - Use a separate wallet for testnet
# ========================================
